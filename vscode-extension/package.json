{
  "name": "read-ai",
  "displayName": "Read AI",
  "description": "Connect VS Code Copilot to Read AI meeting intelligence — transcripts, reports, and meeting agents via MCP.",
  "version": "1.0.0",
  "publisher": "readai",
  "license": "MIT",
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#0B0B0F",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Read-AI-Inc/read-ai-cursor-plugin.git"
  },
  "homepage": "https://www.read.ai",
  "bugs": {
    "url": "https://github.com/Read-AI-Inc/read-ai-cursor-plugin/issues"
  },
  "engines": {
    "vscode": "^1.101.0"
  },
  "categories": [
    "AI",
    "Chat",
    "Other"
  ],
  "keywords": [
    "mcp",
    "read-ai",
    "read.ai",
    "meetings",
    "transcripts",
    "copilot",
    "oauth"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "mcpServerDefinitionProviders": [
      {
        "id": "readai.mcp",
        "label": "Read AI"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package --no-dependencies",
    "publish": "vsce publish"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@types/vscode": "^1.101.0",
    "@vscode/vsce": "^3.3.2",
    "typescript": "^5.8.2"
  }
}
